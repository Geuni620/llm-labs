# CSV의 CRLF와 공백을 보존해 데이터 해시와 글자 단위 집계 기준을 유지합니다.
*.csv -text whitespace=trailing-space,space-before-tab,cr-at-eol

# 무작위 예시의 마지막 필드에는 생성된 공백 글자가 들어갈 수 있습니다.
bigram/random_examples.csv whitespace=-blank-at-eol,blank-at-eof,space-before-tab,cr-at-eol

# 내려받은 원본 데이터와 라이선스의 공백도 원문 그대로 보관합니다.
data/ChatbotData.csv -whitespace
data/LICENSE -text -whitespace
